 <node id="6323333186" visible="true" version="6" changeset="189416849" timestamp="2026-09-22T19:21:28Z" user="hatul" uid="686490" lat="31.7799620" lon="35.2238113">
  <tag k="artwork_type" v="installation"/>
  <tag k="description" v="דגם ענק של רדיו נשיונל פנסוניק. הוצב כחלק מציון 50 שנים לאיחוד ירושליים וכמחווה לשידור הציבורי. אפשר לסובב את הכפתורים בין תחנות ולשנות את העוצמה. ברדיו 5 תחנות מוזיקה: נוסטלגית, להיטים, ים תיכונית, קלאסית, ותחנה של תכניות רדיו ישנות של כאן, תאגיד השידור."/>
  <tag k="description:he" v="דגם ענק של רדיו נשיונל פנסוניק. הוצב כחלק מציון 50 שנים לאיחוד ירושליים וכמחווה לשידור הציבורי. אפשר לסובב את הכפתורים בין תחנות ולשנות את העוצמה. ברדיו 5 תחנות מוזיקה: נוסטלגית, להיטים, ים תיכונית, קלאסית, ותחנה של תכניות רדיו ישנות של כאן, תאגיד השידור."/>
  <tag k="image" v="https://upload.wikimedia.org/wikipedia/commons/thumb/7/7b/National_Panasonic_sculpture,_Kikar_Safra,_2019_(01).jpg/800px-National_Panasonic_sculpture,_Kikar_Safra,_2019_(01).jpg?20191126080131"/>
  <tag k="name" v="National Panasonic Radio"/>
  <tag k="name:en" v="National Panasonic Radio"/>
  <tag k="name:he" v="רדיו ענק"/>
  <tag k="tourism" v="artwork"/>
 </node>
