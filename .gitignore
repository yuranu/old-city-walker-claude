# --- local environments and dependencies
.venv/
game/node_modules/
game/dist/
__pycache__/
*.pyc

# --- build outputs (regenerate with ./build.sh; release archives in build/release)
build/
renders/
data/osm_local.json
data/scene_spec.json
data/terrain.json
data/*.png

# --- generated textures: tinted copies of data/raw/polyhaven (pipeline/fetch_textures.py),
#     pipeline/gen_textures.py, gen_signs.py, gen_landmark_textures.py
data/textures/

# --- reference photos: only the metadata (index.json: source URL, author, licence, position) is
#     versioned. ./fetch_data.sh --photos restores the images (pinned in data/inputs.sha256);
#     pipeline/fetch_ref_photos.py and pipeline/fetch_iconic_photos.py restore or find more.
#     Street View stills (QA references during the research) are never stored here.
data/photos/*.jpg
data/photos_ref/**/*.jpg
data/photos_ref/sv/

# --- the game's runtime data: all built by ./build.sh (models, manifest, plan, photo list, cameras)
game/public/

# --- editor / OS
.DS_Store
*.swp
*~

# --- temporary benchmarking copies (engine work in progress)
game/src/legacy/
data/spec/
build/logs/
data/terrain_street.json
data/landmark_ids.json

# --- wrangler state (deploy/)
.wrangler/
deploy/stage.jsonc
